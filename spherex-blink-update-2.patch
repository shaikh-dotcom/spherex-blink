+              cx={P2.x}
+              cy={P2.y}
+              r={ringR}
+              fill="none"
+              stroke={theme.accent}
+              strokeWidth={1.6}
+              strokeDasharray={ringLen}
+              strokeDashoffset={ringLen * (1 - ring)}
+              transform={`rotate(-90 ${P2.x} ${P2.y})`}
+            />
