+        <circle cx={SUN.x} cy={SUN.y} r={R} fill="none" stroke={theme.ink} strokeOpacity={0.22} strokeWidth={1.4} />
+        {p > 0.001 ? (
+          <path
+            d={`M ${trailStart.x} ${trailStart.y} A ${R} ${R} 0 ${trailLarge} 1 ${trailEnd.x} ${trailEnd.y}`}
