+          left: 96,
+          bottom: 40,
+          fontFamily: fonts.mono,
+          fontSize: 20,
+          letterSpacing: 1,
+          color: theme.ink3,
+          opacity: label,
+        }}
+      >
+        Illustration
+      </div>
+    </div>
+  );
+};
+
+export const hookProgress = (frame: number, start: number, end: number): number => mapRange(frame, start, end, 0, 1);
